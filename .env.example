# Firebase Realtime Database (akses server lewat REST API + service account OAuth2)
# Isi dengan URL database Anda, contoh: https://<PROJECT-ID>.firebaseio.com
FIREBASE_DATABASE_URL=
# JSON service account (satu baris). Dapatkan dari Firebase Console ->
# Project Settings -> Service Accounts -> Generate New Private Key
FIREBASE_SERVICE_ACCOUNT=

# Secret untuk menandatangani JWT sesi (httpOnly cookie). Buat string acak panjang.
JWT_SECRET=

# Admin pertama dibuat otomatis saat login pertama dengan kredensial ini
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Base URL API Pixpayz dari https://pixpayz.com/docs (mis. https://pixpayz.com/api —
# nilai persisnya TIDAK DIKETAHUI dari dokumen, konfirmasi ke penyedia)
PIXPAYZ_BASE_URL=

# Kunci enkripsi AES-256-GCM untuk API key Pixpayz (64 karakter heksadesimal = 32 byte).
# Hasilkan dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Secret untuk cron pemulihan invoice (Authorization: Bearer <nilai>)
CRON_SECRET=
